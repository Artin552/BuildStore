# ============================================================
# BuildStoreNET — переменные окружения для продакшена
# Скопируйте в .env на сервере: cp .env.example .env
# И заполните значения. Файл .env НИКОГДА не попадает в git.
# ============================================================

# Секрет для подписи JWT. Сгенерируйте новый: openssl rand -hex 32
JWT_SECRET=ЗАМЕНИТЕ_НА_openssl_rand_-hex_32

# Origin фронтенда для CORS (ваш домен или http://IP_СЕРВЕРА).
# Если сайт открывается с того же домена, что и API — укажите его, например:
# ALLOWED_ORIGIN=https://mydomain.ru
ALLOWED_ORIGIN=

# Привязка: оставляем 127.0.0.1 — наружу сервер выпускает nginx
HOST=127.0.0.1
PORT=4000
JSON_LIMIT=2mb

# Приложение стоит за nginx — для корректного rate-limiting по IP клиента
TRUST_PROXY=1

# --- SMTP для восстановления пароля (необязательно) ---
# Без этих переменных код сброса печатается только в лог сервера.
# Пример для Яндекс.Почты: host=smtp.yandex.ru port=465, нужен "пароль приложения"
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USER=you@yandex.ru
# EMAIL_PASS=app-password-here
