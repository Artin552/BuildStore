# Переменные окружения для BuildStoreNET

# ============================================================
# НАСТРОЙКИ СЕРВЕРА
# ============================================================
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=1

# ============================================================
# НАСТРОЙКИ БЕЗОПАСНОСТИ
# ============================================================
# JWT_SECRET должен быть минимум 32 символа для продакшена!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# ============================================================
# НАСТРОЙКИ CORS
# ============================================================
# ALLOWED_ORIGIN=https://mydomain.ru

# ============================================================
# НАСТРОЙКИ БАЗЫ ДАННЫХ (PostgreSQL)
# ============================================================
PGHOST=localhost
PGPORT=5432
PGDATABASE=buildstorenet
PGUSER=postgres
PGPASSWORD=62319

# ============================================================
# НАСТРОЙКИ EMAIL (для восстановления пароля)
# ============================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
